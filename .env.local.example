# AIRQUA AI Environment Configuration
# Copy this file to .env.local and configure your environment variables.

# Google Gemini API Key (Server-Only, never prefix with NEXT_PUBLIC_)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Server-Only automatic failover backup & Whisper/Orpheus voice assistance)
# Obtain from https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Optional: Next.js App Base URL (defaults to http://localhost:3000 in dev)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Firebase Client Configuration (Guest mode is enabled by default without these)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=app.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=abc
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=xxxxxxxxxx
NEXT_PUBLIC_FIREBASE_APP_ID=1:xxxxxxxx:web:5xxxxxxxx
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=a-xxxxxxxx

# Optional: Firebase Admin Credentials (Server-only, for token verification)
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
