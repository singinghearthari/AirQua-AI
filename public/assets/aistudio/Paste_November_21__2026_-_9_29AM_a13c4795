    (function () {
      const toggle = document.getElementById('stale-toggle');
      const thumb = document.getElementById('stale-thumb');
      const badge = document.getElementById('freshness-badge');
      const dot = document.getElementById('freshness-dot');
      const text = document.getElementById('freshness-text');
      if (!toggle) return;
      toggle.addEventListener('click', function () {
        const isStale = toggle.getAttribute('aria-checked') === 'true';
        const next = !isStale;
        toggle.setAttribute('aria-checked', String(next));
        if (next) {
          toggle.classList.remove('bg-surface-container');
          toggle.classList.add('bg-primary');
          thumb.classList.remove('translate-x-0');
          thumb.classList.add('translate-x-5');
          badge.classList.remove('bg-aqi-good-container', 'text-on-aqi-good-container');
          badge.classList.add('bg-aqi-moderate-container', 'text-on-aqi-moderate-container');
          dot.classList.remove('bg-aqi-good');
          dot.classList.add('bg-aqi-moderate');
          text.textContent = 'Updated 4h ago • Stale';
        } else {
          toggle.classList.add('bg-surface-container');
          toggle.classList.remove('bg-primary');
          thumb.classList.add('translate-x-0');
          thumb.classList.remove('translate-x-5');
          badge.classList.add('bg-aqi-good-container', 'text-on-aqi-good-container');
          badge.classList.remove('bg-aqi-moderate-container', 'text-on-aqi-moderate-container');
          dot.classList.add('bg-aqi-good');
          dot.classList.remove('bg-aqi-moderate');
          text.textContent = 'Updated 8m ago • Fresh';
        }
      });
    })();
